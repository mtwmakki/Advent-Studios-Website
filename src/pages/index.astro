---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Nav from '../components/Nav.astro';
import Menu from '../components/Menu.astro';
import Hero from '../components/Hero.astro';
import { site } from '../content/site';
---
<Base title={site.meta.title} description={site.meta.description}>
  <Intro />
  <Nav />
  <Menu />
  <main id="top">
    <Hero />
    {/* Temporary placeholder sections (replaced in Tasks 6-8) */}
    <section id="about" style="min-height:100vh;"></section>
    <section id="services" style="min-height:100vh;"></section>
    <section id="faq" style="min-height:100vh;"></section>
  </main>
</Base>
