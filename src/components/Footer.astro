---
import Button from './Button.astro';
import Logo from './Logo.astro';
import { site } from '../content/site';
import { waLink } from '../lib/whatsapp';
---
<footer class="footer" data-cursor-dark data-theme="dark">
  <div class="container">
    <div class="footer__cta">
      <h2 class="footer__title" data-reveal>
        {site.footer.headline.split('’').map((part, i, all) => (
          <>{part}{i < all.length - 1 && <span class="footer__apos">’</span>}</>
        ))}
      </h2>
      <Button href={waLink()} label={site.footer.cta} variant="signal" size="xl" external />
    </div>
    <div class="footer__info">
      <a class="footer__email" href={`mailto:${site.email}`}>{site.email}</a>
      <ul class="footer__socials">
        {site.socials.map((s) => (
          <li><a href={s.href}><span data-roll>{s.label}</span></a></li>
        ))}
      </ul>
    </div>
    <div class="footer__bottom">
      <Logo variant="light" />
      <p class="mono-label">{site.footer.smallPrint}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--obsidian);
    color: var(--bone);
    padding-block: clamp(80px, 12vw, 180px) 40px;
    border-radius: var(--radius-card) var(--radius-card) 0 0;
  }
  .footer__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 32px;
  }
  .footer__title {
    font: 800 clamp(72px, 14vw, 240px)/0.95 var(--font-sans);
    letter-spacing: -0.05em;
  }
  /* Srotone's ExtraBold apostrophe is a wedge; borrow the fallback face's for this one glyph. */
  .footer__apos { font-family: 'Funnel Display', var(--font-sans); letter-spacing: 0; }
  .footer__info {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    margin-top: clamp(56px, 8vw, 120px);
    padding-top: 28px;
    border-top: 1px solid var(--border-dark);
  }
  .footer__email {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font: 500 clamp(20px, 2.2vw, 30px)/1.2 var(--font-sans);
    text-decoration: none;
  }
  .footer__socials { display: flex; flex-wrap: wrap; gap: 28px; }
  .footer__socials a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font: 500 13px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ash);
    text-decoration: none;
    transition: color 0.3s;
  }
  .footer__socials a:hover { color: var(--bone); }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: 48px;
    color: var(--ash);
  }
</style>
