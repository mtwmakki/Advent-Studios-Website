---
import Button from './Button.astro';
import Dashboard from './Dashboard.astro';
import { site } from '../content/site';
import { waLink } from '../lib/whatsapp';
---
<section id="hero" class="hero">
  <div class="container hero__text">
    <h1 class="hero__title" data-reveal="hero">{site.hero.headline}</h1>
    <p class="hero__sub" data-fade>{site.hero.subline}</p>
    <div class="hero__cta" data-fade>
      <Button href={waLink()} label={site.hero.cta} variant="signal" size="lg" external />
    </div>
  </div>
  <div id="hero-panel" class="hero__panel" data-cursor-dark data-cursor-text="Demo">
    <Dashboard />
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--nav-h) + clamp(40px, 7vw, 96px));
    overflow-x: clip;
  }
  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 28px;
  }
  .hero__title {
    max-width: 15ch;
    font: 800 clamp(44px, 7vw, 104px)/1.05 var(--font-display);
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .hero__sub {
    max-width: 46ch;
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.55;
    color: var(--graphite);
  }
  .hero__cta { margin-top: 4px; }

  /* Without JS the panel sits inside the page margins. */
  .hero__panel {
    container: hero-panel / inline-size;
    position: relative;
    height: clamp(460px, 80vh, 820px);
    margin: clamp(48px, 7vw, 88px) var(--gutter) 0;
    border-radius: var(--radius-panel);
    overflow: hidden;
    background: var(--obsidian);
  }
  /* With JS it spans the viewport and is scaled down to the margins until scrolled. */
  :global(html.js) .hero__panel {
    width: 100%;
    margin-inline: 0;
    transform-origin: 50% 0;
    transform: scale(var(--panel-s, 0.86));
    border-radius: calc(var(--radius-panel) / var(--panel-s, 0.86));
    will-change: transform;
  }
  @media (max-width: 767px) {
    .hero__panel { height: clamp(420px, 70svh, 560px); }
  }
</style>
