---
const words = ['Web design', 'UI/UX', 'Apps', 'Automation', 'Brand'];
---
<section id="marquee" class="marquee" aria-label="What we do">
  <div class="marquee__track" data-marquee-track>
    <p class="marquee__item" data-marquee-item>
      {words.map((w) => (
        <>
          <span class="marquee__word">{w}</span>
          <svg class="marquee__sep" viewBox="-4 -4 168 108" aria-hidden="true" focusable="false">
            <polygon points="0,100 0,58 58,0 160,0 160,100 104,100 104,70 92,70 62,100" fill="currentColor" stroke="currentColor" stroke-width="8" stroke-linejoin="round" />
          </svg>
        </>
      ))}
    </p>
  </div>
</section>

<style>
  .marquee {
    padding-block: clamp(32px, 5vw, 72px);
    overflow: hidden;
    border-block: 1px solid var(--mist);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  .marquee__item {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: clamp(24px, 3vw, 48px);
    padding-right: clamp(24px, 3vw, 48px);
    font: 600 clamp(64px, 12vw, 200px)/1 var(--font-sans);
    letter-spacing: -0.045em;
    white-space: nowrap;
  }
  .marquee__sep {
    width: 0.62em;
    height: auto;
    flex-shrink: 0;
    color: var(--ash);
  }
</style>
