---
const words = ['Web design', 'UI/UX', 'Apps', 'Automation', 'Brand'];
---
<section id="marquee" class="marquee" aria-label="What we do">
  <div class="marquee__track" data-marquee-track>
    <p class="marquee__item" data-marquee-item>
      {words.map((w, i) => (
        <span class:list={['marquee__word', { 'is-outline': i % 2 === 1 }]}>{w}</span>
      ))}
    </p>
  </div>
</section>

<style>
  .marquee {
    padding-block: clamp(32px, 5vw, 72px);
    overflow: hidden;
    border-block: 1px solid var(--mist);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  .marquee__item {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: clamp(24px, 3vw, 48px);
    padding-right: clamp(24px, 3vw, 48px);
    font: 600 clamp(64px, 12vw, 200px)/1 var(--font-sans);
    letter-spacing: -0.045em;
    white-space: nowrap;
  }
  .marquee__word.is-outline {
    color: transparent;
    -webkit-text-stroke: max(1.5px, 0.012em) var(--obsidian);
  }
</style>
