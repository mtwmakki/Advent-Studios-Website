---
interface Props {
  href: string;
  label: string;
  variant: 'signal' | 'dark' | 'light' | 'ghost';
  size?: 'md' | 'lg' | 'xl';
  cursorText?: string;
  external?: boolean;
  class?: string;
}
const { href, label, variant, size = 'md', cursorText, external = false, class: className } = Astro.props;
const ext = external ? { target: '_blank', rel: 'noopener' } : {};
---
<a
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
  href={href}
  data-magnetic={size === 'xl' ? '0.25' : '0.35'}
  data-cursor-stick={size === 'xl' ? '' : undefined}
  data-cursor-text={cursorText}
  {...ext}
>
  <span class="btn__fill" aria-hidden="true"></span>
  <span class="btn__inner" data-magnetic-inner>
    <span class="btn__label" data-roll><span>{label}</span><span aria-hidden="true">{label}</span></span>
  </span>
</a>


<style>
  .btn {
    --btn-bg: var(--obsidian);
    --btn-fg: var(--bone);
    --btn-fill: var(--signal);
    --btn-fg-hover: var(--obsidian);
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 26px;
    border-radius: 999px;
    background: var(--btn-bg);
    color: var(--btn-fg);
    font: 500 15px/1 var(--font-sans);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    isolation: isolate;
    will-change: transform;
    transition: color 0.45s var(--ease-out);
  }
  .btn:hover, .btn:focus-visible { color: var(--btn-fg-hover); }

  .btn__fill {
    position: absolute;
    left: var(--fx, 50%);
    top: var(--fy, 50%);
    width: 300%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--btn-fill);
    transform: translate(-50%, -50%) scale(0);
    transition: transform 0.65s var(--ease-out);
    z-index: -1;
    pointer-events: none;
  }
  .btn:hover .btn__fill,
  .btn:focus-visible .btn__fill { transform: translate(-50%, -50%) scale(1); }

  .btn__inner { position: relative; display: inline-flex; align-items: center; pointer-events: none; }

  .btn--signal { --btn-bg: var(--signal); --btn-fg: var(--obsidian); --btn-fill: var(--obsidian); --btn-fg-hover: var(--bone); }
  .btn--dark { --btn-bg: var(--obsidian); --btn-fg: var(--bone); --btn-fill: var(--signal); --btn-fg-hover: var(--obsidian); }
  .btn--light { --btn-bg: var(--bone); --btn-fg: var(--obsidian); --btn-fill: var(--signal); --btn-fg-hover: var(--obsidian); }
  .btn--ghost {
    --btn-bg: transparent; --btn-fg: var(--obsidian); --btn-fill: var(--obsidian); --btn-fg-hover: var(--bone);
    box-shadow: inset 0 0 0 1.5px currentColor;
  }

  .btn--lg { min-height: 60px; padding: 0 34px; font-size: 17px; }
  .btn--xl {
    width: clamp(160px, 18vw, 200px);
    aspect-ratio: 1;
    min-height: 0;
    padding: 0;
    font-size: 18px;
    white-space: normal;
    text-align: center;
  }
</style>
