---
import { site } from '../content/site';
const w = site.work;
const f = w.fold;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const url = (p: string) => `${base}${p}`;
---
<section id="work" class="work" aria-labelledby="work-title">
  <div class="container work__head">
    <p class="work__label mono-label">{w.label}</p>
    <h2 id="work-title" class="work__statement">
      <span class="work__line" data-drift="right">{w.statement[0]}</span>{' '}
      <span class="work__line work__line--2" data-drift="left">{w.statement[1]}</span>
    </h2>
  </div>

  <div class="container work__lead">
    <div class="work__intro">
      <ul class="work__tags" aria-label="Disciplines">
        {w.tags.map((t) => <li class="mono-label">{t}</li>)}
      </ul>
      <p class="work__lead-text" data-rise>{w.lead}</p>
    </div>
  </div>

  <figure class="work__fold">
    <div
      class="fold"
      data-fold
      data-fold-angle="180"
      data-inner={url(f.inner)}
      data-inner-poster={url(f.innerPoster)}
      data-cover={url(f.cover)}
    >
      <div class="fold__stage" data-fold-stage>
        <img class="fold__still fold__still--closed" src={url(f.stillClosed)} alt="" width="767" height="1273" loading="lazy" decoding="async" />
        <img class="fold__still fold__still--open" data-fold-still src={url(f.stillOpen)} alt="" width="2002" height="1484" loading="lazy" decoding="async" />
      </div>
    </div>
    <figcaption class="container work__note"><span class="sr-only">{w.videoLabel} </span>{w.note}</figcaption>
  </figure>

  <div class="container work__grid">
    <div class="work__story">
      {w.story.map((b, i) => (
        <div class="work__block" data-rise>
          <span class="mono-label work__num" aria-hidden="true">0{i + 1}</span>
          <h3>{b.label}</h3>
          <p>{b.text}</p>
        </div>
      ))}
    </div>
    <div class="work__proof" data-site-proof data-rise>
      <p class="mono-label work__proof-label">{w.siteProof.label}</p>
      <ul>
        {w.siteProof.items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .work {
    padding-block: clamp(96px, 12vw, 180px) clamp(48px, 6vw, 96px);
    overflow-x: clip;
  }

  .work__head { display: grid; gap: 20px; }
  .work__label { color: var(--graphite); }
  .work__statement {
    display: grid;
    font: 600 clamp(44px, 7.4vw, 124px)/1.02 var(--font-sans);
    letter-spacing: -0.045em;
  }
  .work__line { display: block; white-space: nowrap; will-change: transform; }
  .work__line--2 { padding-left: clamp(24px, 12vw, 220px); }

  .work__lead {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    margin-top: clamp(40px, 6vw, 88px);
  }
  .work__intro { grid-column: 2; display: grid; gap: 20px; max-width: 52ch; }
  .work__tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .work__tags li { padding: 7px 12px; border: 1px solid var(--mist); border-radius: 999px; color: var(--graphite); }
  .work__lead-text { font-size: clamp(18px, 1.5vw, 21px); line-height: 1.55; color: var(--graphite); }

  /* The foldable. Without JavaScript or with reduced motion: a still of the open device.
     With motion: a tall track whose stage stays pinned while the device opens in 3D. */
  .work__fold { margin: clamp(48px, 7vw, 120px) 0 0; display: grid; gap: 14px; }
  .fold { position: relative; }
  .fold__stage { position: relative; display: grid; place-items: center; }
  .fold__still { grid-area: 1 / 1; display: block; height: auto; }
  .fold__still--open { width: min(1080px, 88vw); }
  .fold__still--closed { display: none; width: auto; height: min(62vh, 560px); }
  :global(html.js:not(.reduced)) .fold:not(.fold--static) { height: 280vh; }
  :global(html.js:not(.reduced)) .fold:not(.fold--static) .fold__stage { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; }
  :global(html.js:not(.reduced)) .fold:not(.fold--static) .fold__still--open { display: none; }
  :global(html.js:not(.reduced)) .fold:not(.fold--static) .fold__still--closed { display: block; transition: opacity 0.4s var(--ease-out); }
  :global(#work.is-3d) .fold__still--closed { opacity: 0; }
  .fold__stage :global(.fold__canvas) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  /* While pinned the canvas is a fixed layer in exactly the stage's place (see fold.ts). */
  .fold__stage :global(.fold__canvas.is-fixed) { position: fixed; inset: auto; top: 0; left: 0; width: 100%; height: 100vh; height: 100svh; }
  .work__note { color: var(--graphite); font-size: 14px; text-align: center; }

  .work__grid { display: grid; gap: clamp(24px, 3vw, 40px); margin-top: clamp(48px, 6vw, 88px); }
  .work__story { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  .work__block { display: grid; align-content: start; gap: 12px; padding-top: 18px; border-top: 1px solid var(--obsidian); }
  .work__num { color: var(--graphite); }
  .work__block h3 { font: 600 20px/1.3 var(--font-sans); letter-spacing: -0.01em; }
  .work__block p { color: var(--graphite); font-size: 16px; line-height: 1.6; }
  .work__proof {
    display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px;
    padding: 20px 24px; border-radius: 16px; background: var(--obsidian); color: var(--bone);
  }
  .work__proof-label { color: var(--ash); }
  .work__proof ul { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .work__proof li { font-weight: 500; font-size: 15px; }
  .work__proof li + li::before { content: '·'; margin-right: 24px; color: var(--ash); }

  @media (max-width: 900px) {
    .work__lead { grid-template-columns: 1fr; }
    .work__intro { grid-column: 1; }
    .work__story { grid-template-columns: 1fr; gap: 20px; }
    .work__proof li + li::before { display: none; }
  }
  @media (max-width: 600px) {
    .work__line { white-space: normal; }
  }
</style>
