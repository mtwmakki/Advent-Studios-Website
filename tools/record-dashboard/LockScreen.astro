---
// Recording stage for the foldable's cover screen while closed: a lock screen with an alert
// from the tracker. Rendered once to an image by record.mjs; never shipped as a page.
import '../styles/tokens.css';
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Recording stage: lock screen</title>
  </head>
  <body>
    <div class="lock">
      <div class="glow glow--a"></div>
      <div class="glow glow--b"></div>
      <p class="date">Monday 10 November</p>
      <p class="time">10:24</p>
      <div class="note">
        <div class="note__head">
          <span class="note__icon" aria-hidden="true"><i></i></span>
          <span class="note__app">Launchpad</span>
          <span class="note__when">now</span>
        </div>
        <p class="note__title">Release 2.4 is due today</p>
        <p class="note__body">3 tasks need you before 5 pm. Bugs open: 13.</p>
      </div>
      <div class="note note--quiet">
        <div class="note__head">
          <span class="note__icon" aria-hidden="true"><i></i></span>
          <span class="note__app">Launchpad</span>
          <span class="note__when">9:40</span>
        </div>
        <p class="note__title">Design review moved to Tue 11</p>
      </div>
      <span class="bar" aria-hidden="true"></span>
    </div>
  </body>
</html>

<style>
  :global(html), :global(body) { margin: 0; background: #111110; }
  .lock {
    position: relative;
    width: 414px;
    height: 600px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 44px 18px 0;
    box-sizing: border-box;
    background: #141413;
    color: var(--bone);
    font-family: var(--font-sans);
  }
  .glow { position: absolute; border-radius: 50%; filter: blur(60px); pointer-events: none; }
  .glow--a { width: 380px; height: 380px; left: -150px; bottom: -170px; background: rgba(255, 79, 26, 0.55); }
  .glow--b { width: 300px; height: 300px; right: -140px; top: 60px; background: rgba(155, 154, 148, 0.28); }
  .date { position: relative; margin: 0; font: 500 15px/1.2 var(--font-sans); color: rgba(242, 241, 236, 0.78); }
  .time { position: relative; margin: 2px 0 30px; font: 600 92px/1 var(--font-sans); letter-spacing: -0.05em; }
  .note {
    position: relative;
    width: 100%;
    box-sizing: border-box;
    padding: 12px 14px 13px;
    border-radius: 20px;
    background: rgba(242, 241, 236, 0.13);
    box-shadow: inset 0 1px 0 rgba(242, 241, 236, 0.16);
    margin-bottom: 8px;
  }
  .note--quiet { background: rgba(242, 241, 236, 0.08); transform: scale(0.96); }
  .note__head { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; font-size: 12px; color: rgba(242, 241, 236, 0.7); }
  .note__icon { width: 20px; height: 20px; border-radius: 6px; background: var(--bone); display: grid; place-items: center; }
  .note__icon i { width: 8px; height: 8px; border-radius: 2px; background: var(--obsidian); }
  .note__app { font-weight: 600; letter-spacing: 0.02em; text-transform: uppercase; font-size: 11px; }
  .note__when { margin-left: auto; }
  .note__title { margin: 0; font: 600 15px/1.3 var(--font-sans); }
  .note__body { margin: 2px 0 0; font: 400 14px/1.35 var(--font-sans); color: rgba(242, 241, 236, 0.82); }
  .bar { position: absolute; bottom: 10px; left: 50%; width: 120px; height: 4px; margin-left: -60px; border-radius: 2px; background: rgba(242, 241, 236, 0.7); }
</style>
